<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete MSIX (Microsoft Store). Lo usa empaquetar.ps1, que pone la versión de Directory.Build.props.
  Identity Name, Publisher y PublisherDisplayName son de prueba: al reservar el nombre en Partner Center, cámbialos por
  los de "Identidad del producto" (Package/Identity/Name, Package/Identity/Publisher, Package/Properties/PublisherDisplayName).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="LectorMd" Publisher="CN=LectorMd" Version="0.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lector MD</DisplayName>
    <PublisherDisplayName>LectorMd</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-MX" />
  </Resources>

  <Applications>
    <Application Id="LectorMd" Executable="LectorMd.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lector MD"
        Description="Lee archivos Markdown en voz alta en español de México."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Abrir con…" y doble clic en un .md: Windows pasa la ruta como argumento, igual que sin empaquetar. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Documento Markdown</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- "lectormd archivo.md" desde la terminal. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="LectorMd.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="lectormd.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- App de escritorio (WPF): restringida, hay que justificarla en el envío. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
