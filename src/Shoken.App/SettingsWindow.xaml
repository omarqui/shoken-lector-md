<Window x:Class="Shoken.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Shoken"
        Width="660" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource LectorFontSize14}"
        ResizeMode="CanResizeWithGrip">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" MinWidth="100" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Guardar" IsDefault="True" MinWidth="100" Padding="12,6" Click="OnSaveClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">

                <!-- Interfaz -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Interfaz" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tema" VerticalAlignment="Center" />
                    <ComboBox x:Name="PaletteBox" Grid.Column="1" Margin="0,4" SelectionChanged="OnPaletteChanged">
                        <ComboBoxItem Content="Clásico (blanco y gris)" />
                        <ComboBoxItem Content="Papel (cálido, menos brillo)" />
                        <ComboBoxItem Content="Grafito (gris azulado)" />
                        <ComboBoxItem Content="Sepia y noche" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Tamaño del texto" VerticalAlignment="Center" />
                    <ComboBox x:Name="TextSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="OnTextSizeChanged">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Grande (+15 %)" />
                        <ComboBoxItem Content="Muy grande (+30 %)" />
                    </ComboBox>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="170,4,0,0">
                    Se ven al instante y, si cancelas, vuelven como estaban. Cada tema tiene versión clara y oscura:
                    el botón sol/luna de la ventana elige cuál. El documento se agranda aparte, con Ctrl + rueda del mouse.
                </TextBlock>

                <Separator Margin="0,22" />

                <!-- Azure -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Azure Speech · motor principal" />
                <TextBlock Style="{StaticResource Hint}">
                    Voces neuronales en español de México. Un recurso de Speech en la capa gratuita (F0) incluye
                    500 000 caracteres al mes; la app lleva la cuenta y cambia a Piper antes de pasarse.
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Clave" VerticalAlignment="Center" />
                    <PasswordBox x:Name="AzureKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="1" Text="Región" VerticalAlignment="Center" />
                    <TextBox x:Name="AzureRegionBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                             ToolTip="La región del recurso, p. ej. eastus, southcentralus, westus2" />

                    <TextBlock Grid.Row="2" Text="Voz" VerticalAlignment="Center" />
                    <ComboBox x:Name="AzureVoiceBox" Grid.Row="2" Grid.Column="1" Margin="0,4" IsEditable="True" />

                    <TextBlock Grid.Row="3" Text="Límite mensual" VerticalAlignment="Center" />
                    <TextBox x:Name="LimitBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                             ToolTip="Caracteres por mes. Las etiquetas SSML (pausas, marcas) también cuentan." />

                    <TextBlock Grid.Row="4" Text="Id de directorio" VerticalAlignment="Center" />
                    <TextBox x:Name="AzureTenantBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                             ToolTip="Opcional. Solo para el botón ⟳ del consumo real: el Id del directorio (tenant) del recurso, en el portal en Microsoft Entra ID → Información general. Déjalo vacío para buscar en todos." />
                </Grid>

                <TextBlock Style="{StaticResource Hint}" Margin="170,4,0,8">
                    Dalia (mujer) y Jorge (hombre) son las más naturales. Para que el respaldo no cambie de género,
                    combina Dalia con es_MX-claude y Jorge con es_MX-ald.
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="170,0,0,0">
                    <Button x:Name="TestAzureButton" Content="Probar Azure" Padding="12,6" Click="OnTestAzureClick" />
                    <TextBlock x:Name="AzureTestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <Separator Margin="0,22" />

                <!-- Google -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Google Cloud · respaldo de Azure" />
                <TextBlock Style="{StaticResource Hint}">
                    Entra cuando Azure no está disponible (sin cuota, sin conexión o con error), antes de Piper. El plan
                    gratuito de las voces Neural2 incluye 1 000 000 de caracteres al mes; al pasarlo Google cobra, por eso
                    la app lleva la cuenta y no lo usa más allá del límite.
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Clave de API" VerticalAlignment="Center" />
                    <PasswordBox x:Name="GoogleKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,4"
                                 ToolTip="Clave de API de Google Cloud restringida a Cloud Text-to-Speech API" />

                    <TextBlock Grid.Row="1" Text="Voz" VerticalAlignment="Center" />
                    <ComboBox x:Name="GoogleVoiceBox" Grid.Row="1" Grid.Column="1" Margin="0,4" IsEditable="True" />

                    <TextBlock Grid.Row="2" Text="Límite mensual" VerticalAlignment="Center" />
                    <TextBox x:Name="GoogleLimitBox" Grid.Row="2" Grid.Column="1" Margin="0,4"
                             ToolTip="Caracteres por mes. Se cuenta el SSML completo (estimación conservadora)." />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="170,8,0,0">
                    <Button x:Name="TestGoogleButton" Content="Probar Google" Padding="12,6" Click="OnTestGoogleClick" />
                    <TextBlock x:Name="GoogleTestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <Separator Margin="0,22" />

                <!-- Kokoro -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Kokoro · voz local natural" />
                <TextBlock Style="{StaticResource Hint}">
                    Lee sin conexión, con una voz más natural que Piper, y va antes que Piper cuando Azure y Google no
                    están disponibles. Corre en el equipo, sin tarjeta gráfica, con acento mexicano. Su modelo pesa unos
                    310 MB y se descarga una sola vez (no cierres esta ventana mientras se descarga).
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Modelo" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <Button x:Name="KokoroDownloadButton" Padding="12,6" Click="OnDownloadKokoroClick" />
                        <TextBlock x:Name="KokoroModelStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Voz" VerticalAlignment="Center" />
                    <ComboBox x:Name="KokoroVoiceBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="170,8,0,0">
                    <Button x:Name="TestKokoroButton" Content="Probar Kokoro" Padding="12,6" Click="OnTestKokoroClick" />
                    <TextBlock x:Name="KokoroTestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <Separator Margin="0,22" />

                <!-- Piper -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Piper · respaldo sin conexión" />
                <TextBlock Style="{StaticResource Hint}">
                    El último respaldo: se usa si no hay Kokoro o falla. Necesitas piper.exe (con su carpeta
                    espeak-ng-data) y un modelo de voz es_MX: el archivo .onnx y su .onnx.json en la misma carpeta.
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="piper.exe" VerticalAlignment="Center" />
                    <TextBox x:Name="PiperExeBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Examinar…" Padding="10,5" Margin="8,4,0,4" Click="OnBrowsePiperClick" />

                    <TextBlock Grid.Row="1" Text="Modelo (.onnx)" VerticalAlignment="Center" />
                    <TextBox x:Name="PiperModelBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Examinar…" Padding="10,5" Margin="8,4,0,4" Click="OnBrowseModelClick" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="170,8,0,0">
                    <Button x:Name="TestPiperButton" Content="Probar Piper" Padding="12,6" Click="OnTestPiperClick" />
                    <TextBlock x:Name="PiperTestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <CheckBox x:Name="OfflineOnlyBox" Margin="170,14,0,0"
                          Content="Usar solo los motores locales: Kokoro y Piper (no conectarse a Azure ni Google)" />

                <Separator Margin="0,22" />

                <!-- Lectura -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Lectura" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Velocidad de la voz" VerticalAlignment="Center" />
                    <Slider x:Name="RateSlider" Grid.Row="0" Grid.Column="1" Margin="0,6" VerticalAlignment="Center"
                            Minimum="-30" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="OnRateChanged" />
                    <TextBlock x:Name="RateLabel" Grid.Row="0" Grid.Column="2" Width="52" Margin="10,0,0,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="Bloques de código" VerticalAlignment="Center" />
                    <ComboBox x:Name="CodeModeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                        <ComboBoxItem Content="Anunciar el lenguaje (&quot;Bloque de código en C#&quot;)" />
                        <ComboBoxItem Content="Omitirlos" />
                        <ComboBoxItem Content="Leer el código línea por línea" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Tablas" VerticalAlignment="Center" />
                    <ComboBox x:Name="TableModeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                        <ComboBoxItem Content="Leer fila por fila (&quot;Columna: valor&quot;)" />
                        <ComboBoxItem Content="Solo anunciar cuántas filas y columnas tiene" />
                        <ComboBoxItem Content="Omitirlas" />
                    </ComboBox>
                </Grid>

                <TextBlock Style="{StaticResource Hint}" Margin="170,4,0,6">
                    La velocidad de la voz se aplica al generar el audio (cambiarla vuelve a sintetizar y gasta cuota).
                    Para ir más rápido sin gastar, usa el control «Velocidad» de la ventana principal.
                </TextBlock>

                <CheckBox x:Name="ImageAltBox" Margin="170,4,0,0" Content="Leer el texto alternativo de las imágenes" />

                <Separator Margin="0,22" />

                <!-- Apuntes -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Apuntes para la IA" />
                <TextBlock Style="{StaticResource Hint}">
                    «Copiar para la IA» (en la columna de apuntes) copia esta instrucción y, debajo, cada apunte pendiente
                    con su línea del Markdown, su sección, el texto señalado y tu nota. Al copiar, {archivo} se cambia por
                    la ruta del documento, {titulo} por su título y {cantidad} por cuántos apuntes van.
                </TextBlock>
                <TextBox x:Name="NotesInstructionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Instrucción para la IA" />
                <Button Content="Restaurar la instrucción original" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0"
                        Click="OnRestoreNotesInstructionClick" />

                <Separator Margin="0,22" />

                <!-- Pronunciación y caché -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Pronunciación y caché" />
                <TextBlock Style="{StaticResource Hint}">
                    El diccionario reemplaza palabras completas antes de leer (p. ej. "JSON" → "yéison"). Los cambios
                    se aplican al recargar el documento (F5). La caché guarda el audio ya generado para no pagarlo dos veces.
                </TextBlock>

                <WrapPanel>
                    <Button Content="Editar diccionario de pronunciación" Padding="12,6" Margin="0,0,8,8" Click="OnEditDictionaryClick" />
                    <Button Content="Vaciar caché de audio" Padding="12,6" Margin="0,0,8,8" Click="OnClearCacheClick" />
                    <Button Content="Abrir carpeta de datos" Padding="12,6" Margin="0,0,8,8" Click="OnOpenDataFolderClick" />
                </WrapPanel>
                <TextBlock x:Name="CacheInfo" Opacity="0.72" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
