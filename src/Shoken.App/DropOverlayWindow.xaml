<Window x:Class="Shoken.App.DropOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shoken · soltar archivos"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontSize="{DynamicResource LectorFontSize14}"
        Background="Transparent" AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <!-- La superficie que recibe el arrastre, casi invisible y en toda la ventana: un píxel del todo transparente no lo
         recibiría. Nada de adentro recibe el mouse, así que DragLeave solo llega al salir de la ventana (o al cancelar
         con Esc), no al pasar de la tarjeta al fondo. -->
    <Grid Background="#01000000">
        <Grid x:Name="Root" IsHitTestVisible="False">
            <!-- Atenúa la ventana con el fondo y la tiñe del acento (o de gris, si lo arrastrado no se puede abrir). -->
            <Rectangle Fill="{DynamicResource LectorBackgroundBrush}" Opacity="0.82" />
            <Rectangle x:Name="Tint" Opacity="0.12" />
            <Rectangle x:Name="Frame" Margin="14" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5 3" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="40" Padding="32,24"
                    CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource LectorSurfaceBrush}" BorderBrush="{DynamicResource LectorBorderBrush}">
                <StackPanel>
                    <Border x:Name="Badge" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center">
                        <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                               FontSize="{DynamicResource LectorFontSize16}" Foreground="{DynamicResource LectorTextBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="DetailText" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="{DynamicResource LectorFontSize12}" Foreground="{DynamicResource LectorText2Brush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
