<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shoken.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.52.0" />
    <!-- Kokoro (voz local natural). Sin buildTransitive/contentFiles: el paquete copiaría sus 61 voces (79 MB);
         la app trae solo las tres en español (Assets\kokoro). El modelo se descarga desde Configuración. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" ExcludeAssets="buildTransitive;contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shoken.Core.Tests" />
  </ItemGroup>

  <!-- Demo de entonación: el texto y los datos de la grabación (los genera empaquetado/generar-demo.cs, que compila
       este proyecto antes de que existan; la prueba de la demo falla si faltan o quedaron viejos). -->
  <ItemGroup>
    <EmbeddedResource Include="Demo\asi-lee-shoken.md" LogicalName="demo.md" />
    <EmbeddedResource Include="Demo\grabacion.json" LogicalName="demo-grabacion.json" Condition="Exists('Demo\grabacion.json')" />
  </ItemGroup>

</Project>
