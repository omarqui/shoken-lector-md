<Window x:Class="LectorMd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:LectorMd.App.Controls"
        Title="Lector MD"
        Width="1120" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource LectorBackgroundBrush}"
        AllowDrop="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnWindowStateChanged"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- Barra de título propia: las pestañas viven en ella. Lo que no es clicable se arrastra y doble clic maximiza. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel x:Name="RootPanel">
        <!-- Barra de título con pestañas -->
        <Grid DockPanel.Dock="Top" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource LectorAccentBrush}">
                    <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE767;" HorizontalAlignment="Center"
                               Foreground="{DynamicResource LectorOnAccentBrush}" />
                </Border>
                <TextBlock Text="Lector MD" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource LectorText2Brush}" />
            </StackPanel>

            <!-- Alineado a la izquierda: el resto de la columna queda libre para arrastrar la ventana. -->
            <DockPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Button DockPanel.Dock="Right" Click="OnNewTabClick" ToolTip="Pestaña nueva (Ctrl+T): pega un texto Markdown o una ruta"
                        AutomationProperties.Name="Pestaña nueva" WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource FlatIconButton}" Width="36" Height="32" Margin="2,0,0,2" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE710;" />
                </Button>
                <ListBox x:Name="TabList" SelectionChanged="OnTabSelectionChanged" BorderThickness="0" Background="Transparent"
                         Padding="0" WindowChrome.IsHitTestVisibleInChrome="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <!-- Solapa como en un navegador: la activa toma el color de la barra de comandos y se une a ella. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip}" />
                            <Setter Property="Foreground" Value="{DynamicResource LectorText2Brush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tab" Height="36" Margin="0,4,2,0" Padding="14,0,4,0" CornerRadius="8,8,0,0"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource LectorSurface2Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource LectorSurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource LectorTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseUp" Handler="OnTabMouseUp" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Archivo .md, texto pegado (en memoria) o pestaña vacía. -->
                                <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="{Binding Icon}" Margin="0,0,9,0"
                                           Foreground="{DynamicResource LectorAccentBrush}" />
                                <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <Button Click="OnCloseTabClick" ToolTip="Cerrar (Ctrl+W)" AutomationProperties.Name="Cerrar pestaña"
                                        Style="{StaticResource FlatIconButton}" Width="24" Height="24" Margin="10,0,0,0" Focusable="False">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE711;"
                                               Foreground="{DynamicResource LectorText2Brush}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <controls:CaptionButtons Grid.Column="2" />
        </Grid>

        <!-- Barra de comandos -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                Background="{DynamicResource LectorSurfaceBrush}" BorderBrush="{DynamicResource LectorBorderBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ToggleButton x:Name="OutlineToggle" Click="OnOutlineToggleClick" ToolTip="Mostrar u ocultar el índice (Ctrl+B)"
                                  Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" />
                    </ToggleButton>
                    <Button Click="OnOpenClick" ToolTip="Abrir un archivo Markdown (Ctrl+O)" Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PreviousButton" Click="OnPreviousClick" ToolTip="Sección anterior (Ctrl+←)" Padding="10,6" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="PlayButton" Click="OnPlayClick" ToolTip="Leer o pausar (Espacio)" Padding="14,6" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,8,0" />
                            <TextBlock x:Name="PlayLabel" Text="Leer" VerticalAlignment="Center" MinWidth="58" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="OnStopClick" ToolTip="Detener (Esc)" Padding="10,6" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" />
                    </Button>
                    <Button x:Name="NextButton" Click="OnNextClick" ToolTip="Sección siguiente (Ctrl+→)" Padding="10,6">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Velocidad" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.72" />
                    <Slider x:Name="SpeedSlider" Width="130" VerticalAlignment="Center"
                            Minimum="0.75" Maximum="1.75" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            SmallChange="0.05" LargeChange="0.25" Value="1"
                            ValueChanged="OnSpeedChanged" />
                    <TextBlock x:Name="SpeedLabel" Text="1.00×" Width="46" VerticalAlignment="Center" Margin="8,0,12,0" />
                    <Button x:Name="ThemeButton" Click="OnThemeClick" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Click="OnSettingsClick" ToolTip="Configuración (Ctrl+,)" Padding="10,6">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom" Padding="12,7" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EngineDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="Gray" />
                    <TextBlock x:Name="EngineText" Text="Sin motor de voz" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Opacity="0.72" />

                <StackPanel x:Name="UsagePanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UsageText" VerticalAlignment="Center" Opacity="0.72" />
                    <ProgressBar x:Name="UsageBar" Width="90" Height="4" Margin="10,0,0,0" Minimum="0" Maximum="1"
                                 VerticalAlignment="Center" />
                    <Button x:Name="UsageRefreshButton" Click="OnUsageRefreshClick" Padding="6,2" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTip="Consultar en Azure el consumo real de este mes">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Índice y documento -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OutlinePanel" Width="260" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Índice" FontWeight="SemiBold" Margin="14,12,14,6" />
                    <TextBlock x:Name="OutlineEmpty" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap"
                               Margin="14,4" Opacity="0.72" />
                    <ListBox x:Name="OutlineList" BorderThickness="0" Background="Transparent" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnOutlineKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,4" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnOutlineItemClick" />
                                <EventSetter Event="MouseDoubleClick" Handler="OnOutlineItemDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Margin="{Binding Margin}" FontWeight="{Binding Weight}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <wv2:WebView2 x:Name="Browser" />
                <TextBlock x:Name="BrowserError" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
