<Window x:Class="LectorMd.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lector MD · reproductor"
        Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!-- Tarjeta flotante abajo a la derecha. El margen deja lugar a la sombra. -->
    <Border Margin="12" CornerRadius="10" Padding="14,10,8,12" BorderThickness="1"
            Background="{DynamicResource LectorSurfaceBrush}" BorderBrush="{DynamicResource LectorBorderBrush}"
            MouseLeftButtonDown="OnDragStart">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Border Width="18" Height="18" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource LectorAccentBrush}">
                    <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE767;" HorizontalAlignment="Center"
                               Foreground="{DynamicResource LectorOnAccentBrush}" />
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButton}" Width="28" Height="28" Click="OnCloseClick"
                        ToolTip="Cerrar (la lectura sigue)" AutomationProperties.Name="Cerrar el mini reproductor">
                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButton}" Width="28" Height="28" Click="OnOpenMainClick"
                        ToolTip="Abrir Lector MD" AutomationProperties.Name="Abrir Lector MD">
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE8A7;" />
                </Button>
                <TextBlock x:Name="SectionText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource LectorTextBrush}" />
            </DockPanel>
            <TextBlock x:Name="DetailText" FontSize="12" Margin="28,0,8,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource LectorText2Brush}" />

            <Grid Margin="0,8,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" Text="--:--" FontFamily="Cascadia Code, Consolas" FontSize="11"
                           Foreground="{DynamicResource LectorText2Brush}" />
                <Grid Grid.Column="1" Height="4" Margin="10,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource LectorTrackBrush}" CornerRadius="2" />
                    <Border x:Name="ProgressFill" Background="{DynamicResource LectorAccentBrush}" CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="RemainingText" Grid.Column="2" Text="--:--" FontFamily="Cascadia Code, Consolas" FontSize="11"
                           Foreground="{DynamicResource LectorText2Brush}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button x:Name="StopButton" Style="{StaticResource FlatIconButton}" Width="34" Height="34" Click="OnStopClick"
                        ToolTip="Detener" AutomationProperties.Name="Detener">
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE71A;" Foreground="{DynamicResource LectorText2Brush}" />
                </Button>
                <Button Style="{StaticResource FlatIconButton}" Width="34" Height="34" Margin="4,0,0,0" Click="OnPreviousClick"
                        ToolTip="Sección anterior" AutomationProperties.Name="Sección anterior">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE892;" />
                </Button>
                <Button Style="{StaticResource FlatIconButton}" Width="38" Height="34" Margin="2,0,0,0" Click="OnBack10Click"
                        ToolTip="Retroceder 10 segundos" AutomationProperties.Name="Retroceder 10 segundos">
                    <TextBlock Text="−10" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LectorTextBrush}" />
                </Button>
                <Button x:Name="PlayButton" Width="40" Height="40" Margin="6,0" Click="OnPlayClick" Cursor="Hand"
                        ToolTip="Leer o pausar" AutomationProperties.Name="Pausar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" CornerRadius="20" Background="{DynamicResource LectorAccentBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE769;"
                               Foreground="{DynamicResource LectorOnAccentBrush}" />
                </Button>
                <Button Style="{StaticResource FlatIconButton}" Width="38" Height="34" Margin="0,0,2,0" Click="OnForward10Click"
                        ToolTip="Adelantar 10 segundos" AutomationProperties.Name="Adelantar 10 segundos">
                    <TextBlock Text="+10" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LectorTextBrush}" />
                </Button>
                <Button Style="{StaticResource FlatIconButton}" Width="34" Height="34" Margin="0,0,4,0" Click="OnNextClick"
                        ToolTip="Sección siguiente" AutomationProperties.Name="Sección siguiente">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE893;" />
                </Button>
                <Button x:Name="SpeedButton" Style="{StaticResource FlatIconButton}" Height="34" Padding="8,0" Click="OnSpeedClick"
                        ToolTip="Cambiar la velocidad">
                    <TextBlock x:Name="SpeedText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LectorTextBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
